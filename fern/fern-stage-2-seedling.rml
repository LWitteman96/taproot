            <KeyedObject objectId="2:347" id="2:852">
                <KeyedProperty propertyKey="37" id="2:853">
                    <KeyFrameColor frame="0" value="FF98A585" interpolationType="linear" id="2:851"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="2:40" id="2:855">
                <KeyedProperty propertyKey="15" id="2:856">
                    <KeyFrameDouble frame="0" value="-0.201599" interpolationType="linear" id="2:854"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="2:253" id="2:858">
                <KeyedProperty propertyKey="37" id="2:859">
                    <KeyFrameColor frame="0" value="FF8B9A7E" interpolationType="linear" id="2:857"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="Fern" id="2:3">

            <!-- the sway owns rotation on the inner *-sway nodes.
                 vitality scales its amplitude between Still and Sway. -->
            <StateMachineLayer name="Sway" id="2:5">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="2:6"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="2:6">
                    <BindablePropertyNumber id="2:7">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="2:16"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="2:12" value="0"/>
                    <BlendAnimation1D animationId="2:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="2:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="2:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="2:9">
                    <BindablePropertyNumber id="2:10">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="2:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="2:14" value="0"/>
                    <BlendAnimation1D animationId="2:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <DataConverterGroup name="Droop" id="2:15">
        <DataConverterGroupItem converterId="2:860"/>
        <DataConverterGroupItem converterId="2:861"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Droop Smoothing" id="2:860">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="2:862"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Droop Range" id="2:861">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="2:863"/>
    </DataConverterRangeMapper>

    <DataConverterGroup name="Sway" id="2:16">
        <DataConverterGroupItem converterId="2:864"/>
        <DataConverterGroupItem converterId="2:865"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Sway Smoothing" id="2:864">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="2:866"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="40" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Sway Range" id="2:865">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="2:867"/>
    </DataConverterRangeMapper>
</Rive>
