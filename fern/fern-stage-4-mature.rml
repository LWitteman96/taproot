        <StateMachine name="Fern" id="4:3">

            <!-- the sway owns rotation on the inner *-sway nodes.
                 vitality scales its amplitude between Still and Sway. -->
            <StateMachineLayer name="Sway" id="4:5">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="4:6"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="4:6">
                    <BindablePropertyNumber id="4:7">
                        <DataBindContext sourcePathIds="0:2-0:3" propertyKey="636" converterId="4:16"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="4:12" value="0"/>
                    <BlendAnimation1D animationId="4:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="4:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="4:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="4:9">
                    <BindablePropertyNumber id="4:10">
                        <DataBindContext sourcePathIds="0:2-0:3" propertyKey="636" converterId="4:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="4:14" value="0"/>
                    <BlendAnimation1D animationId="4:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
