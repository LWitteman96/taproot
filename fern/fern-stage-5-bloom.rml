        <StateMachine name="Fern" id="5:3">

            <!-- the sway owns rotation on the inner *-sway nodes.
                 vitality scales its amplitude between Still and Sway. -->
            <StateMachineLayer name="Sway" id="5:5">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="5:6"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="5:6">
                    <BindablePropertyNumber id="5:7">
                        <DataBindContext sourcePathIds="0:2-0:3" propertyKey="636" converterId="5:16"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="5:12" value="0"/>
                    <BlendAnimation1D animationId="5:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="5:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="5:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="5:9">
                    <BindablePropertyNumber id="5:10">
                        <DataBindContext sourcePathIds="0:2-0:3" propertyKey="636" converterId="5:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="5:14" value="0"/>
                    <BlendAnimation1D animationId="5:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
