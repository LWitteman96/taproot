        <DataConverterGroupItem converterId="2:462"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Sway Smoothing" id="2:461">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="2:463"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="40" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Sway Range" id="2:462">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="2:464"/>
