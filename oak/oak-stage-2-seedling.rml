                    <BlendAnimation1D animationId="2:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="2:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="2:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="2:9">
                    <BindablePropertyNumber id="2:10">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="2:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="2:14" value="0"/>
                    <BlendAnimation1D animationId="2:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <DataConverterGroup name="Droop" id="2:15">
        <DataConverterGroupItem converterId="2:457"/>
        <DataConverterGroupItem converterId="2:458"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Droop Smoothing" id="2:457">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="2:459"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Droop Range" id="2:458">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="2:460"/>
    </DataConverterRangeMapper>

    <DataConverterGroup name="Sway" id="2:16">
