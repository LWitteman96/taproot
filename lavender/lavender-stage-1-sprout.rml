                <KeyedProperty propertyKey="37" id="1:285">
                    <KeyFrameColor frame="0" value="FFBABEA0" interpolationType="linear" id="1:283"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:59" id="1:287">
                <KeyedProperty propertyKey="15" id="1:288">
                    <KeyFrameDouble frame="0" value="0.087266" interpolationType="linear" id="1:286"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:67" id="1:290">
                <KeyedProperty propertyKey="37" id="1:291">
                    <KeyFrameColor frame="0" value="FFBABEA0" interpolationType="linear" id="1:289"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:42" id="1:293">
                <KeyedProperty propertyKey="15" id="1:294">
                    <KeyFrameDouble frame="0" value="-0.523599" interpolationType="linear" id="1:292"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:55" id="1:296">
                <KeyedProperty propertyKey="37" id="1:297">
                    <KeyFrameColor frame="0" value="FFB5B596" interpolationType="linear" id="1:295"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="Lavender" id="1:3">

            <!-- the sway owns rotation on the inner *-sway nodes.
                 vitality scales its amplitude between Still and Sway. -->
            <StateMachineLayer name="Sway" id="1:5">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="1:6"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="1:6">
                    <BindablePropertyNumber id="1:7">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="1:16"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="1:12" value="0"/>
                    <BlendAnimation1D animationId="1:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="1:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="1:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="1:9">
                    <BindablePropertyNumber id="1:10">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="1:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="1:14" value="0"/>
                    <BlendAnimation1D animationId="1:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <DataConverterGroup name="Droop" id="1:15">
        <DataConverterGroupItem converterId="1:298"/>
        <DataConverterGroupItem converterId="1:299"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Droop Smoothing" id="1:298">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="1:300"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Droop Range" id="1:299">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="1:301"/>
    </DataConverterRangeMapper>

    <DataConverterGroup name="Sway" id="1:16">
        <DataConverterGroupItem converterId="1:302"/>
        <DataConverterGroupItem converterId="1:303"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Sway Smoothing" id="1:302">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="1:304"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="40" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Sway Range" id="1:303">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="1:305"/>
    </DataConverterRangeMapper>
</Rive>
