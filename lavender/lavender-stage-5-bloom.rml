    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Droop Smoothing" id="5:4102">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="5:4104"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Droop Range" id="5:4103">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="5:4105"/>
