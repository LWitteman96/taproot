        </LinearAnimation>

        <LinearAnimation fps="60" duration="60" name="Leaning" id="3:21">
            <KeyedObject objectId="3:23" id="3:1520">
                <KeyedProperty propertyKey="15" id="3:1521">
                    <KeyFrameDouble frame="0" value="-0.087266" interpolationType="linear" id="3:1519"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="Lavender" id="3:3">

            <!-- the sway owns rotation on the inner *-sway nodes.
                 vitality scales its amplitude between Still and Sway. -->
            <StateMachineLayer name="Sway" id="3:5">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="3:6"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="3:6">
                    <BindablePropertyNumber id="3:7">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="3:16"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="3:12" value="0"/>
                    <BlendAnimation1D animationId="3:11" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- vitality owns rotation on the outer *-droop nodes,
                 and the fills that fade -->
            <StateMachineLayer name="Vitality" id="3:8">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="3:9"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="3:9">
                    <BindablePropertyNumber id="3:10">
                        <DataBindContext sourcePathIds="9:2-9:3" propertyKey="636" converterId="3:15"/>
                    </BindablePropertyNumber>
                    <!-- ascending value order: the runtime binary-searches these -->
                    <BlendAnimation1D animationId="3:14" value="0"/>
                    <BlendAnimation1D animationId="3:13" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <!-- a plant taller than its roots leans. this layer owns
                 rotation on the plant node; nothing else touches it. -->
            <StateMachineLayer name="Stability" id="3:17">
                <AnyState x="420" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="3:18"/>
                </EntryState>
                <BlendState1DViewModel x="160" y="0" id="3:18">
                    <BindablePropertyNumber id="3:19">
                        <DataBindContext sourcePathIds="9:2-9:5" propertyKey="636" converterId="3:22"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="3:21" value="0"/>
                    <BlendAnimation1D animationId="3:20" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <DataConverterGroup name="Droop" id="3:15">
        <DataConverterGroupItem converterId="3:1522"/>
        <DataConverterGroupItem converterId="3:1523"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Droop Smoothing" id="3:1522">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="3:1524"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Droop Range" id="3:1523">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="3:1525"/>
    </DataConverterRangeMapper>

    <DataConverterGroup name="Sway" id="3:16">
        <DataConverterGroupItem converterId="3:1526"/>
        <DataConverterGroupItem converterId="3:1527"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="0.6" interpolationType="cubic"
                               name="Sway Smoothing" id="3:1526">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="3:1528"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="40" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              interpolationType="cubic" name="Sway Range" id="3:1527">
        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1" id="3:1529"/>
    </DataConverterRangeMapper>

    <DataConverterGroup name="Stability" id="3:22">
        <DataConverterGroupItem converterId="3:1530"/>
        <DataConverterGroupItem converterId="3:1531"/>
    </DataConverterGroup>

    <DataConverterInterpolator duration="1.2" interpolationType="cubic"
                               name="Stability Smoothing" id="3:1530">
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="3:1532"/>
    </DataConverterInterpolator>

    <DataConverterRangeMapper minInput="0" maxInput="0.3" minOutput="0" maxOutput="100"
                              clampLower="true" clampUpper="true"
                              name="Stability Range" id="3:1531"/>
</Rive>
