#!/usr/bin/env bash
set -e

# ── Source must be text ─────────────────────────────────────────────────────
#
# Runs before the TTY guard below, deliberately: a literal NUL byte reached
# `lib/app/sync/sync_tables.dart` through a non-interactive commit, which is the
# path that returns early. A check that only runs when a human is watching is
# not a check.
#
# Why it matters: git calls a blob with a NUL in it binary, so the file shows as
# `Bin 2807 -> 3382 bytes` in every diff and PR view, and `git grep -I` — the
# secret scan — skips it. `dart format` and `flutter analyze` both parse such a
# file without complaint, so nothing else in the pipeline objects.
staged_sources=$(git diff --cached --name-only --diff-filter=ACM -- lib test)
offenders=""
for f in $staged_sources; do
  [ -f "$f" ] || continue
  if ! tr -d '\000' < "$f" | cmp -s - "$f"; then
    offenders="$offenders $f"
  fi
done
if [ -n "$offenders" ]; then
  echo "pre-commit: these staged files contain a NUL byte and are binary to git:$offenders" >&2
  echo "pre-commit: write it as an escape (\\u0000) rather than as a literal." >&2
  exit 1
fi

# Interactive version bumper. Bumps pubspec.yaml's version/build number and
# stages it as part of the commit.
#
# Skip the prompt when there's no controlling TTY (CI, scripted commits, agents
# committing over a pipe). Without this guard, opening /dev/tty fails and
# `set -e` aborts the commit — which silently breaks every non-interactive
# commit path.
if ! { : </dev/tty; } 2>/dev/null; then
  echo "pre-commit: no controlling TTY, skipping version bump prompt."
  exit 0
fi

read -p "Bump version? (y/n): " bump </dev/tty
if [[ "$bump" != "y" ]]; then
  echo "Skipping version bump."
  exit 0
fi

read -p "Which bump? (major/minor/patch/none): " type </dev/tty

if [[ ! "$type" =~ ^(major|minor|patch|none)$ ]]; then
  echo "Invalid bump type. Use major, minor, patch, or none."
  exit 1
fi

pubspec="pubspec.yaml"

current=$(grep "^version:" "$pubspec" | awk '{print $2}')
semver=${current%%+*}
build=${current##*+}

IFS='.' read -r major minor patch <<< "$semver"

if [[ "$type" != "none" ]]; then
  case "$type" in
    major) ((major++)); minor=0; patch=0 ;;
    minor) ((minor++)); patch=0 ;;
    patch) ((patch++)) ;;
  esac
fi

# The build number always increments, including on `none`.
((build++))

new_version="$major.$minor.$patch+$build"

sed -i.bak "s/^version: .*/version: $new_version/" "$pubspec"
rm "$pubspec.bak"

echo ""
echo "✨ Version updated to $new_version"
echo ""

git add "$pubspec"

# Explicitly signal success — the last command's status would otherwise leak out.
exit 0
